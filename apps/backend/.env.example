# ─── Core ────────────────────────────────────────────────────
# Server environment: development | production | test
NODE_ENV=development
# Port the backend binds to (default: 3001)
PORT=3001

# ─── Database ────────────────────────────────────────────────
# Local dev: Docker Compose PostgreSQL
# Railway: auto-injected when you link a PostgreSQL plugin
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staylark
# Production: append ?connection_limit=10 to DATABASE_URL

# ─── Authentication (Better Auth) ───────────────────────────
# Generate a unique secret per environment: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
# Must exactly match this backend's public URL (including protocol, no trailing slash)
BETTER_AUTH_URL=http://localhost:3001
# Frontend origin for CORS — must match exactly (no trailing slash)
FRONTEND_URL=http://localhost:4200

# ─── Email (Resend) ─────────────────────────────────────────
# Optional in development — console logger prints email links to terminal
# Sign up at https://resend.com to get an API key
RESEND_API_KEY=
# Sender address — must match a verified domain in Resend (production)
# Default: onboarding@resend.dev (Resend test sender, delivers to your Resend account email only)
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── AI (self-hosted inference service) ──────────────────────
# Base URL of the self-hosted inference service (STT + analysis)
INFERENCE_URL=http://localhost:8000
# Shared secret used to authenticate against the inference service
INFERENCE_API_KEY=local
# Set to "true" to use fake AI responses in development (no inference service needed)
USE_INFERENCE_MOCK=true

# ─── AI (OpenAI — still used by the Tickets feature) ─────────
# Feedback no longer uses OpenAI; kept until the Tickets feature is migrated.
OPENAI_API_KEY=
# Set to "true" to use fake AI responses for tickets in development
USE_OPENAI_MOCK=true

# ─── Storage (Cloudinary) ────────────────────────────────────
# Optional in development — image/audio upload won't work without valid keys
# Sign up at https://cloudinary.com to get credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# BACKEND ONLY — never expose this to the frontend
CLOUDINARY_API_SECRET=
# Folder prefix to isolate uploads per environment. Local dev: "dev". Staging: "stg".
# Production: leave empty so existing URLs (e.g. /properties/...) keep resolving.
# Allowed chars: lowercase alphanumeric and hyphens.
CLOUDINARY_FOLDER_PREFIX=dev

# ─── Bookings ────────────────────────────────────────────────
# PENDING bookings older than this (hours) are auto-cancelled. 48h keeps the
# calendar fresh while surviving weekends.
PENDING_EXPIRY_HOURS=48
# Set to "true" on staging to expose Swagger UI at /api/docs. Leave unset in production.
ENABLE_API_DOCS=false
