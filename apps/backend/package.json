{
    "name": "@staylark/backend",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.32.1",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "build": "tsup",
        "start": "prisma migrate deploy && node dist/server.js",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.check.json",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate",
        "db:reset": "prisma migrate reset",
        "verify:pricing": "tsx scripts/verify-pricing-math.ts",
        "train:pricing": "tsx scripts/train-pricing-model.ts",
        "train:pricing:real": "tsx scripts/train-pricing-model-real.ts",
        "verify:openapi": "tsx scripts/verify-openapi.ts",
        "gen:openapi": "tsx scripts/generate-openapi.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.4",
        "@prisma/client": "^6.9.0",
        "@staylark/contract": "workspace:*",
        "@sentry/node": "^10.58.0",
        "better-auth": "^1.2.8",
        "cloudinary": "^2.6.1",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "multer": "^1.4.5-lts.2",
        "openai": "^5.8.2",
        "papaparse": "^5.5.4",
        "pino": "^9.6.0",
        "pino-http": "^11.0.0",
        "prisma": "^6.9.0",
        "read-excel-file": "^9.3.5",
        "resend": "^4.5.1",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "write-excel-file": "^4.1.1",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.2",
        "@types/multer": "^1.4.12",
        "@types/node": "^24.10.1",
        "@types/papaparse": "^5.5.2",
        "@types/supertest": "^7.2.0",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^9.39.4",
        "globals": "^16.5.0",
        "pino-pretty": "^13.0.0",
        "socket.io-client": "^4.8.3",
        "supertest": "^7.2.2",
        "tsup": "^8.5.1",
        "tsx": "^4.19.4",
        "typescript": "catalog:",
        "typescript-eslint": "^8.57.0",
        "vitest": "^3.2.4"
    }
}
