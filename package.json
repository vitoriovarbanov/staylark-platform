{
    "name": "staylark",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm --parallel --filter @staylark/backend --filter @staylark/frontend dev",
        "build": "pnpm --filter @staylark/contract build && pnpm --filter @staylark/backend build && pnpm --filter @staylark/frontend build",
        "lint": "pnpm -r lint",
        "typecheck": "pnpm -r typecheck",
        "prepare": "husky || true"
    },
    "lint-staged": {
        "apps/frontend/**/*.{ts,tsx}": "eslint --fix --config apps/frontend/eslint.config.js",
        "apps/backend/**/*.{ts,tsx}": "eslint --fix --config apps/backend/eslint.config.js",
        "*.{ts,tsx,json,css}": "prettier --write"
    },
    "devDependencies": {
        "eslint": "^9.39.4",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.0",
        "prettier": "^3.5.3",
        "typescript": "catalog:"
    },
    "packageManager": "pnpm@10.32.1",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@prisma/client",
            "@prisma/engines",
            "prisma",
            "esbuild"
        ]
    }
}
