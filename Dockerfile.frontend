FROM node:22-slim AS build

RUN corepack enable

WORKDIR /app

# Copy monorepo root files needed for pnpm install and TypeScript
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./

# Copy workspace package.json files
COPY packages/contract/package.json packages/contract/package.json
COPY apps/frontend/package.json apps/frontend/package.json

RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/contract/ packages/contract/
COPY apps/frontend/ apps/frontend/

# Vite bakes VITE_* vars at build time — pass via Railway build-time variables
ARG VITE_API_URL
ARG VITE_CLOUDINARY_CLOUD_NAME
ARG VITE_CLOUDINARY_UPLOAD_PRESET
ARG VITE_SENTRY_DSN
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_CLOUDINARY_CLOUD_NAME=$VITE_CLOUDINARY_CLOUD_NAME
ENV VITE_CLOUDINARY_UPLOAD_PRESET=$VITE_CLOUDINARY_UPLOAD_PRESET
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN

# Build contract (no-op) then frontend
RUN pnpm --filter @staylark/contract build && \
    pnpm --filter @staylark/frontend build

FROM node:22-slim AS runtime

RUN npm install -g serve

WORKDIR /app

COPY --from=build /app/apps/frontend/dist dist
COPY apps/frontend/serve.json dist/serve.json

CMD ["sh", "-c", "serve dist -s -l tcp://0.0.0.0:${PORT:-3000}"]