FROM node:22-slim AS build

RUN corepack enable
WORKDIR /app

# Dependency layer (cached unless package.json/lockfile change)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages/contract/package.json packages/contract/package.json
COPY apps/backend/package.json apps/backend/package.json
RUN pnpm install --frozen-lockfile

# Source + build
COPY packages/contract/ packages/contract/
COPY apps/backend/ apps/backend/
RUN pnpm --filter @staylark/contract build && \
    pnpm --filter @staylark/backend build

FROM node:22-slim AS runtime

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY packages/contract/package.json packages/contract/package.json
COPY apps/backend/package.json apps/backend/package.json
RUN pnpm install --frozen-lockfile --prod

# Copy built artifacts
COPY --from=build /app/apps/backend/dist apps/backend/dist
COPY --from=build /app/apps/backend/prisma apps/backend/prisma
COPY --from=build /app/packages/contract packages/contract

# Generate Prisma client in runtime node_modules
RUN pnpm --filter @staylark/backend exec prisma generate

WORKDIR /app/apps/backend
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]
